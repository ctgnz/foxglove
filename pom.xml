<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>io.github.ctgnz</groupId>
    <artifactId>foxglove</artifactId>
    <version>0.11.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    
    <name>Foxglove SVG/JavaFX</name>
    <description>Native support for SVG in JavaFX</description>
    <url>https://www.ctg.co.nz/foxglove</url>
    
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    
    <developers>
        <developer>
            <name>Colin Sharples</name>
            <email>ctg@ctg.co.nz</email>
            <organization>CTG Games Ltd</organization>
            <organizationUrl>http://www.ctg.co.nz</organizationUrl>
        </developer>
    </developers>
    
    <scm>
        <connection>scm:git:git://github.com/ctgnz/foxglove.git</connection>
        <developerConnection>scm:git:ssh://github.com:ctgnz/foxglove.git</developerConnection>
        <url>http://github.com/ctgnz/foxglove/tree/master</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Imports the JUnit BOM so junit-jupiter, junit-platform-suite, and whatever junit-platform-* artifacts
        Cucumber pulls in transitively all resolve to one consistent version, rather than leaving it to Maven's
        nearest-wins mediation.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>25.0.3</version>
        </dependency>
        
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>25.0.3</version>
        </dependency>
        
		<dependency>
		    <groupId>org.apache.commons</groupId>
		    <artifactId>commons-lang3</artifactId>
		    <version>3.12.0</version>
		</dependency>

		<dependency>
		    <groupId>org.apache.commons</groupId>
		    <artifactId>commons-text</artifactId>
		    <version>1.10.0</version>
		</dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.1-jre</version>
        </dependency>
        
		<dependency>
		    <groupId>org.eclipse.persistence</groupId>
		    <artifactId>org.eclipse.persistence.moxy</artifactId>
		    <version>5.0.0</version>
		    <exclusions>
		        <exclusion>
		            <groupId>org.eclipse.angus</groupId>
		            <artifactId>angus-mail</artifactId>
		        </exclusion>
		    </exclusions>
		</dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>7.34.8</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>7.34.8</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>2.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-all</artifactId>
            <version>2.0.2-beta</version>
            <scope>test</scope>
        </dependency>

        <!--
            #196: drives headless Chromium to generate fresh W3C conformance reference images (see
            W3cSvgReferenceGenerator) and, #208, to seek a live reference for the animation check (see
            PlaywrightAnimationReference, used by W3cSvgAnimationCheck and its own
            PlaywrightAnimationReferenceCheck). A plain test-scope dependency, not profile-scoped: declaring it
            doesn't download the Chromium binary itself (only Playwright.create(), which only those classes call,
            does that), and none of them run as part of the default `mvn test`/`mvn verify` - every one of them,
            like W3cSvgConformanceCheck, has a name deliberately chosen not to match Surefire's own default
            test-discovery patterns.
        -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.63.0</version>
            <scope>test</scope>
        </dependency>

        <!--
            #224: extracts the svg/ entries of the W3C suite tarball ConformanceSuiteBrowser fetches at its own
            launch time (the JDK has no built-in tar reader - only java.util.zip.GZIPInputStream for the outer
            gzip layer). Test-scope only, same as the Playwright dependency above; not used by any main-scope code.

            Pinned to 1.26.1, not the current 1.28.0 - confirmed directly (grepping TarArchiveEntry.class across
            every cached version) that 1.26.2+ needs org.apache.commons.lang3.SystemProperties, only added in
            commons-lang3 3.13+, while this project's own existing main-scope commons-lang3 dependency stays at
            3.12.0 - bumping that shared dependency instead turned out to cascade into real deprecation warnings
            across several src/main files under this project's -Werror, unrelated scope creep for what only this
            test-only dev tool actually needs. 1.26.1 has no such reference, so it works against 3.12.0 unmodified.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.26.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <profiles>
        <profile>
            <!--
                On-demand: `mvn -Pconformance test`. Fetches the W3C SVG 1.1 test suite (not vendored - see
                W3cSvgConformanceCheck's own javadoc) and runs it against a checked-in baseline manifest. Kept out
                of the default build/CI job entirely: W3cSvgConformanceCheck's name deliberately doesn't match
                Surefire's own default test-discovery patterns (**/*Test.java etc.), so no exclude is even needed
                in the base build - this profile is the only thing that ever includes it.
            -->
            <id>conformance</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.13.0</version>
                        <executions>
                            <execution>
                                <id>fetch-w3c-svg-testsuite</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>wget</goal>
                                </goals>
                                <configuration>
                                    <url>https://www.w3.org/Graphics/SVG/Test/20110816/archives/W3C_SVG_11_TestSuite.tar.gz</url>
                                    <sha256>b5f46cca1ad79b670f9179770b2366c57efd5c671d084144090feab4b7ff1030</sha256>
                                    <unpack>true</unpack>
                                    <outputDirectory>${project.build.directory}/w3c-svg-testsuite</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        #196: installs the headless Chromium W3cSvgReferenceGenerator drives, as a genuine separate
                        OS process (the `exec` goal, not `java`) rather than a Playwright.CLI.main() call from
                        inside the test itself or exec:java's own in-process classloader invocation - CLI.main()
                        calls System.exit() and writes raw progress-bar output directly to native stdout, either of
                        which corrupts or kills whatever JVM it runs inside (Surefire's forked test JVM, or even
                        Maven's own JVM under exec:java's default in-process mode). Idempotent (a fast no-op once
                        already installed), so unconditional here is fine - the same reasoning that already lets the
                        suite fetch above run unconditionally regardless of which -Dtest= class actually needs it.
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>install-playwright-chromium</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <classpathScope>test</classpathScope>
                                    <!-- %classpath is only substituted within commandlineArgs, not a per-element
                                         <arguments> list - confirmed empirically after the <arguments> form passed
                                         the literal string "%classpath" through unsubstituted. -->
                                    <commandlineArgs>-cp %classpath com.microsoft.playwright.CLI install chromium</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/W3cSvgConformanceCheck.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!--
                            Publishes to the Central Portal, which replaced OSSRH. The plugin uploads directly, so
                            no distributionManagement repository is needed.

                            autoPublish is false, so a tag stages a validated deployment on the Portal and
                            publishing to Central stays a deliberate step. Set it to true to publish automatically,
                            which is what the previous nexus-staging autoReleaseAfterClose did.
                        -->
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    
    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <!-- The previous default predates the JUnit Platform entirely and cannot discover Jupiter/Cucumber tests. -->
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.44.5</version>
                <configuration>
                    <java>
                        <importOrder>
                            <file>${maven.multiModuleProjectDirectory}/config/eclipse.importorder</file>
                        </importOrder>
                        <removeUnusedImports/>
                        <eclipse>
                            <file>${maven.multiModuleProjectDirectory}/config/eclipse-formatter.xml</file>
                        </eclipse>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>